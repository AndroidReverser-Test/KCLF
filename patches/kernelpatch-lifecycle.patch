diff --git a/checks/test_module_lifecycle.py b/checks/test_module_lifecycle.py
new file mode 100644
--- /dev/null
+++ b/checks/test_module_lifecycle.py
@@ -0,0 +1,128 @@
+#!/usr/bin/env python3
+"""Compile the real module lifecycle bodies against deterministic host stubs.
+
+This tests exit veto / operation serialization / callback RCU context, not the
+kernel's RCU implementation, instruction patching, or device boot image.
+Run with: python3 checks/test_module_lifecycle.py
+"""
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = (ROOT / "kernel/patch/module/module.c").read_text()
+
+
+def function(signature):
+    start = SOURCE.index(signature)
+    opening = SOURCE.index("{", start)
+    depth = 0
+    for i in range(opening, len(SOURCE)):
+        depth += (SOURCE[i] == "{") - (SOURCE[i] == "}")
+        if depth == 0:
+            return SOURCE[start:i + 1]
+    raise AssertionError(signature)
+
+
+PRELUDE = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define __user
+#define logkfi(...) ((void)0)
+#define logkfe(...) ((void)0)
+#define smp_store_release(p,v) atomic_store_explicit(p,v,memory_order_release)
+#define cmpxchg(p,old,newv) host_cmpxchg(p,old,newv)
+static int host_cmpxchg(_Atomic int *p, int old, int newv) {
+    atomic_compare_exchange_strong_explicit(p, &old, newv, memory_order_acq_rel, memory_order_acquire);
+    return old;
+}
+static _Atomic int module_operation_busy;
+struct module {
+    char *args, *ctl_args;
+    void *start;
+    int list;
+    long (**exit)(void *);
+    long (**ctl0)(const char *, char *, int);
+    long (**ctl1)(void *, void *, void *);
+};
+static struct module *active;
+static int exit_rc, exit_calls, ctl_calls, unlinked, grace, tasks, frees, fail_alloc;
+static int in_rcu;
+static void tasks_sync(void) { assert(!in_rcu); tasks++; }
+static void (*module_synchronize_tasks)(void) = tasks_sync;
+static struct module *find_module(const char *name) { return !strcmp(name,"test") ? active : NULL; }
+static void list_del_rcu(int *list) { assert(list == &active->list); unlinked++; active = NULL; }
+static void synchronize_rcu(void) { assert(!in_rcu); grace++; }
+static void kp_free_exec(void *p) { assert(grace && tasks); free(p); frees++; }
+static void kvfree(void *p) { free(p); }
+static void *vmalloc(size_t n) { return fail_alloc ? NULL : malloc(n); }
+long unload_module(const char *, void *);
+long module_control0(const char *, const char *, char *, int);
+static long exit_cb(void *unused) {
+    (void)unused;
+    assert(!in_rcu);
+    exit_calls++;
+    /* Callback reentrancy must fail, not deadlock or free the module. */
+    assert(unload_module("test",NULL) == -EBUSY);
+    return exit_rc;
+}
+static long ctl_cb(const char *arg, char *out, int len) {
+    (void)out; (void)len;
+    assert(!in_rcu && !strcmp(arg,"hello"));
+    ctl_calls++;
+    assert(module_control0("test","nested",NULL,0) == -EBUSY);
+    assert(unload_module("test",NULL) == -EBUSY);
+    return 37;
+}
+'''
+
+MAIN = r'''
+int main(void) {
+    long (*exit_fn)(void *) = exit_cb;
+    long (*ctl_fn)(const char *,char *,int) = ctl_cb;
+    active = calloc(1,sizeof(*active)); assert(active);
+    active->exit = &exit_fn;
+    active->ctl0 = &ctl_fn;
+    active->start = malloc(32); assert(active->start);
+    assert(unload_module(NULL,NULL) == -EINVAL);
+    assert(unload_module("absent",NULL) == -ENOENT);
+    assert(!atomic_load(&module_operation_busy));
+    assert(module_control0("test","hello",NULL,0) == 37);
+    assert(ctl_calls == 1 && !atomic_load(&module_operation_busy));
+    fail_alloc = 1;
+    assert(module_control0("test","hello",NULL,0) == -ENOMEM);
+    assert(!active->ctl_args && !atomic_load(&module_operation_busy));
+    fail_alloc = 0;
+    assert(module_control0("test","hello",NULL,0) == 37);
+    exit_rc = -EBUSY;
+    struct module *saved = active;
+    assert(unload_module("test",NULL) == -EBUSY);
+    assert(active == saved && !unlinked && !grace && !frees);
+    assert(module_control0("test","hello",NULL,0) == 37);
+    exit_rc = 0;
+    assert(unload_module("test",NULL) == 0);
+    assert(!active && exit_calls == 2 && unlinked == 1 && grace == 1 && tasks == 1 && frees == 1);
+    assert(!atomic_load(&module_operation_busy));
+    puts("module lifecycle: exit veto, reentrancy, allocation failure, grace order PASS");
+    return 0;
+}
+'''
+
+parts = [function(x) for x in (
+    "static bool module_operation_enter(", "static void module_operation_leave(",
+    "long unload_module(", "long module_control0(")]
+with tempfile.TemporaryDirectory(prefix="kp-lifecycle-") as directory:
+    src = Path(directory) / "test.c"
+    exe = Path(directory) / "test"
+    src.write_text(PRELUDE + "\n" + "\n".join(parts) + MAIN)
+    subprocess.run(["gcc", "-std=gnu11", "-Wall", "-Wextra", "-Werror", "-g",
+                    "-fsanitize=address,undefined", str(src), "-o", str(exe)], check=True)
+    subprocess.run([str(exe)], check=True)
+
+assert "kfunc_call(synchronize_rcu)" in (ROOT / "kernel/linux/include/linux/rcupdate.h").read_text()
+print("native synchronize_rcu dispatch: PASS")
